{
  "name": "notes-api",
  "version": "1.0.0",
  "description": "Notes API used by the end-to-end DevOps project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node scripts/build.js",
    "test": "jest --coverage"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": { "global": { "lines": 80, "functions": 80 } }
  }
}
